# 复制为 .env 后修改
FLOW_PORT=8080
FLOW_PUBLIC_URL=http://your-server:8080
# PostgreSQL；使用 1Panel 安装的 PostgreSQL 时主机名为其容器名，并设置 FLOW_NETWORK=1panel-network、FLOW_NETWORK_EXTERNAL=true
FLOW_DATABASE_URL=postgres://flow:password@postgres-host:5432/flow?sslmode=disable
# 首次启动时 admin 的密码
FLOW_ADMIN_PASSWORD=change-me-now
# Server 与内置构建节点共用的令牌（openssl rand -hex 24）
FLOW_RUNNER_TOKEN=
FLOW_RUNNER_LABELS=linux,docker
FLOW_CONCURRENCY=2
FLOW_RUNNER_WORKDIR=/opt/flow-runner
FLOW_NETWORK=flow
FLOW_NETWORK_EXTERNAL=false
